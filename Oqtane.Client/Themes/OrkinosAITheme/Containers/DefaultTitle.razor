@namespace Oqtane.Themes.OrkinosAITheme
@inherits ContainerBase

<div class="card mb-4 @_containerCssClass">
    <div class="card-header @_headerCssClass">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0"><ModuleTitle /></h5>
            @if (ShowControls)
            {
                <ModuleActions />
            }
        </div>
    </div>
    
    <div class="card-body @_bodyCssClass">
        <ModuleInstance />
    </div>
</div>

@code {
    public override string Name => "OrkinosAI Default Title Container";

    private string _containerStyle = "default";
    private string _containerCssClass = "";
    private string _headerCssClass = "bg-primary text-white";
    private string _bodyCssClass = "";

    protected override void OnParametersSet()
    {
        try
        {
            var settings = SettingService.MergeSettings(PageState.Site.Settings, PageState.Page.Settings, PageState.Module.Settings);
            _containerStyle = SettingService.GetSetting(settings, GetType().Namespace + ":ContainerStyle", "default");
            
            // Set CSS classes based on container style
            switch (_containerStyle)
            {
                case "primary":
                    _containerCssClass = "border-primary";
                    _headerCssClass = "bg-primary text-white";
                    _bodyCssClass = "";
                    break;
                case "secondary":
                    _containerCssClass = "border-secondary";
                    _headerCssClass = "bg-secondary text-white";
                    _bodyCssClass = "";
                    break;
                case "success":
                    _containerCssClass = "border-success";
                    _headerCssClass = "bg-success text-white";
                    _bodyCssClass = "";
                    break;
                case "info":
                    _containerCssClass = "border-info";
                    _headerCssClass = "bg-info text-white";
                    _bodyCssClass = "";
                    break;
                case "warning":
                    _containerCssClass = "border-warning";
                    _headerCssClass = "bg-warning text-dark";
                    _bodyCssClass = "";
                    break;
                case "danger":
                    _containerCssClass = "border-danger";
                    _headerCssClass = "bg-danger text-white";
                    _bodyCssClass = "";
                    break;
                case "light":
                    _containerCssClass = "border-light";
                    _headerCssClass = "bg-light text-dark border-bottom";
                    _bodyCssClass = "";
                    break;
                case "dark":
                    _containerCssClass = "border-dark";
                    _headerCssClass = "bg-dark text-white";
                    _bodyCssClass = "";
                    break;
                default:
                    _containerCssClass = "";
                    _headerCssClass = "bg-primary text-white";
                    _bodyCssClass = "";
                    break;
            }
        }
        catch
        {
            // error loading container settings - use defaults
        }
    }
}