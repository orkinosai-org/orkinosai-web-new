@page
@model Microsoft.AspNetCore.Mvc.RazorPages.PageModel
@{
    ViewData["Title"] = "OrkinosAI";
}
<link rel="stylesheet" href="~/css/homepage.css" />

<header class="site-nav">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <img src="~/images/orkinosai-logo.png" alt="OrkinosAI logo" class="nav-logo" />
    </a>
    <nav class="primary-nav" aria-label="Primary">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<section class="ms-banner-wrap" aria-hidden="false">
  <div class="container">
    <img src="~/images/ms-startups-banner.png" alt="Microsoft for Startups banner" class="ms-banner" />
  </div>
</section>

<main class="hero container" role="main">
  <div class="hero-inner">
    <img src="~/images/orkinosai-logo.png" alt="OrkinosAI logo" class="hero-logo" />
    <h1 class="hero-title">OrkinosAI — Practical AI for teams</h1>
    <p class="hero-lead">Build, assist, and scale with AI-powered tools designed for developers and startups.</p>
    <div class="hero-ctas">
      <a class="btn primary-cta" href="/docs">Get started</a>
      <a class="btn outline-cta" href="/contact">Contact us</a>
    </div>
  </div>
</main>

<section class="features container" aria-label="Features">
  <div class="feature-grid">
    <article>
      <h3>Powerful integrations</h3>
      <p>Connect tooling and accelerate workflows with AI-driven automations.</p>
    </article>
    <article>
      <h3>Enterprise-ready</h3>
      <p>Security, compliance, and scale for startups and teams.</p>
    </article>
    <article>
      <h3>Human-centered design</h3>
      <p>Accessible, responsive interfaces built for real users.</p>
    </article>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <small>&copy; @DateTime.UtcNow.Year OrkinosAI</small>
  </div>
</footer>